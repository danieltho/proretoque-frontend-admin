# --- Local dev (pnpm dev directly on the host) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_BASE_URL=http://localhost:8000

# --- Docker dev (docker compose up) ---
# Inside compose, VITE_API_BASE_URL is forced to /api/v1 (relative) so the
# browser hits the Vite dev server, which proxies to BACKEND_URL.
# Override the default backend from the host shell:
#   BACKEND_URL=https://staging.api.example.com docker compose up
BACKEND_URL=http://host.docker.internal:8000
